/* Zeno dashboard-aligned Qt theme (theme.json drives color and font tokens).
   Mirrors zeno-dashboard: Space Mono everywhere, 6px inputs on card-hover,
   2px buttons, small uppercase muted labels, lime focus and primary. */

* {
    font-family: {font.family};
    font-size: {font.size-pt}pt;
    outline: none;
    icon-size: 16px;
}

QWidget {
    color: {color.foreground};
    background: {color.background};
}

QDialog, QMainWindow {
    background: {color.background};
}

/* ---- Text ---------------------------------------------------------------- */

QLabel {
    background: transparent;
    color: {color.foreground};
}

QLabel#dialogTitle {
    font-size: 15pt;
    font-weight: bold;
    color: {color.foreground};
}

/* Form labels and section headings: text-xs uppercase text-muted. The top padding
   groups each label with the field under it while layouts keep a small spacing. */
QLabel#fieldLabel, QLabel#section {
    font-size: 8pt;
    font-weight: bold;
    color: {color.muted};
    padding-top: 10px;
}

QLabel#muted {
    color: {color.muted};
    font-size: 9pt;
}

QLabel#error {
    color: {color.danger};
    font-size: 9pt;
}

QToolTip {
    color: {color.foreground};
    background: {color.card};
    border: 1px solid {color.border};
    padding: 4px 8px;
}

QGroupBox {
    border: 1px solid {color.border};
    border-radius: 6px;
    margin-top: 8px;
    padding-top: 8px;
    font-weight: bold;
    color: {color.muted};
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 8px;
    padding: 0 4px;
}

/* ---- Inputs: rounded-md border-border bg-card-hover, focus:border-primary --- */

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDoubleSpinBox {
    border: 1px solid {color.border};
    border-radius: 6px;
    background: {color.card-hover};
    color: {color.foreground};
    padding: 7px 10px;
    selection-background-color: {color.selection-bg};
    selection-color: {color.selection-text};
}

QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus {
    border-color: {color.primary};
}

QLineEdit:disabled, QPlainTextEdit:disabled, QComboBox:disabled {
    color: {color.muted};
}

QComboBox {
    border: 1px solid {color.border};
    border-radius: 6px;
    background: {color.card-hover};
    color: {color.foreground};
    padding: 7px 30px 7px 10px;
}

QComboBox:hover {
    border-color: #404040;
}

QComboBox:focus, QComboBox:on {
    border-color: {color.primary};
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    border: none;
    width: 28px;
}

QComboBox::down-arrow {
    image: url("{path.icons}/chevron-down.svg");
    width: 14px;
    height: 14px;
}

QComboBox QAbstractItemView {
    background: {color.card};
    color: {color.foreground};
    border: 1px solid {color.border};
    border-radius: 6px;
    padding: 4px;
    selection-background-color: rgba(212, 255, 0, 0.10);
    selection-color: {color.primary};
}

/* ---- Buttons: btn-secondary / btn-primary ---------------------------------- */

QPushButton {
    border: 1px solid {color.border};
    border-radius: 2px;
    background: transparent;
    color: {color.foreground};
    padding: 7px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background: {color.card-hover};
}

QPushButton:pressed {
    background: {color.card};
}

QPushButton:disabled {
    color: #555555;
    border-color: #1f1f1f;
}

QPushButton#primaryButton, QPushButton[primary="true"] {
    background: {color.primary};
    color: {color.primary-foreground};
    border-color: {color.primary};
}

QPushButton#primaryButton:hover, QPushButton[primary="true"]:hover {
    background: #c2e800;
    border-color: #c2e800;
}

QPushButton#primaryButton:disabled, QPushButton[primary="true"]:disabled {
    background: #3d4a00;
    border-color: #3d4a00;
    color: #0a0a0a;
}

/* ---- Checks and radios ------------------------------------------------------ */

QCheckBox, QRadioButton {
    background: transparent;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #404040;
    border-radius: 3px;
    background: {color.card-hover};
}

QCheckBox::indicator:hover {
    border-color: {color.muted};
}

QCheckBox::indicator:checked {
    background: {color.primary};
    border-color: {color.primary};
    image: url("{path.icons}/check.svg");
}

QRadioButton::indicator {
    width: 12px;
    height: 12px;
    border-radius: 7px;
    border: 1px solid #404040;
    background: {color.card-hover};
}

QRadioButton::indicator:checked {
    background: {color.primary};
    border-color: {color.primary};
}

/* ---- Lists and trees ---------------------------------------------------------- */

QListWidget, QListView, QTreeWidget, QTreeView {
    background: {color.card};
    border: 1px solid {color.border};
    border-radius: 6px;
    color: {color.foreground};
    padding: 4px;
    show-decoration-selected: 1;
}

QListWidget::item, QListView::item, QTreeWidget::item, QTreeView::item {
    padding: 5px 6px;
    border-radius: 4px;
}

QListWidget::item:hover, QListView::item:hover, QTreeWidget::item:hover, QTreeView::item:hover {
    background: {color.card-hover};
}

QListWidget::item:selected, QListView::item:selected, QTreeWidget::item:selected, QTreeView::item:selected {
    background: rgba(212, 255, 0, 0.10);
    color: {color.primary};
}

QTreeView::branch {
    background: transparent;
}

QTreeView::branch:has-children:closed {
    image: url("{path.icons}/chevron-right.svg");
}

QTreeView::branch:has-children:open {
    image: url("{path.icons}/chevron-down.svg");
}

QHeaderView::section {
    background: {color.card};
    color: {color.muted};
    border: none;
    border-bottom: 1px solid {color.border};
    padding: 6px 8px;
    font-size: 8pt;
    font-weight: bold;
}

QScrollArea {
    border: none;
    background: transparent;
}

/* ---- Scrollbars: 6px, thumb border → muted on hover ---------------------------- */

QScrollBar:vertical {
    background: {color.scrollbar-track};
    width: 6px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background: {color.scrollbar-thumb};
    min-height: 24px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover, QScrollBar::handle:horizontal:hover {
    background: {color.muted};
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
}

QScrollBar::add-page, QScrollBar::sub-page {
    background: transparent;
}

QScrollBar:horizontal {
    background: {color.scrollbar-track};
    height: 6px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background: {color.scrollbar-thumb};
    min-width: 24px;
    border-radius: 3px;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
}
